# Optional. Without it, the simulator plans turns with the offline intent matcher.
OPENROUTER_API_KEY=
# Optional. Comma-separated OpenRouter model ids, first is primary.
# KEEPER_LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# Optional. Private Vercel Blob store for households; without it, households live in .data/ (or /tmp on Vercel).
BLOB_READ_WRITE_TOKEN=
# Optional. Signs the per-visitor allowance cookie.
KEEPER_COOKIE_SECRET=
# Optional demo limits: model-planned turns per visitor per day, and model calls per server per day.
# KEEPER_TURNS_PER_VISITOR=6
# KEEPER_LLM_CALLS_PER_DAY=15
